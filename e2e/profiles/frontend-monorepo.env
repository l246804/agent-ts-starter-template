# Pre-answered decision points for the "pure frontend, monorepo" profile
# (frontend × monorepo): a pnpm workspace whose root is a shell and whose app is
# apps/website, reaching an external backend through the app's dev proxy.
#
# This file is exactly what a user would answer when running GUIDE.md attended;
# the harness exports it so the whole flow can run unattended. Names and meanings
# are the guide's answer contract (GUIDE.md, "Answers").
#
# Placeholders run.sh fills before exporting the answers:
#   __STUB_PORT__   the port its deterministic proxy target listens on
#   __FREE_PORT2__  a free port for the app's dev server
#
# Everything else is a decision and must be answered explicitly.

# Phase 1 — shape, layout, scaffold base, package manager
GUIDE_MODE=frontend
GUIDE_LAYOUT=monorepo
# The monorepo template writes the app (create-vite's vanilla-ts template, in
# apps/website); this revision does not re-scaffold it, and the guard refuses any
# other answer before writing anything.
GUIDE_FRAMEWORK=vanilla-ts
GUIDE_PM=pnpm

# Phase 2 — versions (prereleases are disclosed at this decision point)
GUIDE_VP_VERSION=1.0.0-rc.0
GUIDE_TS_VERSION=^7.0.2
GUIDE_TNB=no
GUIDE_TNB_VERSION=6.0.3-bridge.17.tsgo.7.0.2
GUIDE_SKILLS_VERSION=1.7.0

# Phase 1 — the layout's placeholder sub-package decision: the answer here is `no`,
# which is the branch this profile exists to run: the workspace with the scaffolded
# packages/utils deleted, so the layout-only answer is the one that is exercised.
GUIDE_PLACEHOLDER=no

# Phase 3.5 — dev proxy: the backend address the app calls through /api
GUIDE_DEV_PROXY=http://127.0.0.1:__STUB_PORT__
GUIDE_PROXY_SMOKE_PATH=/hello

# Phase 6 — the port the app's dev server binds
GUIDE_WEBSITE_PORT=__FREE_PORT2__

# Phase 4.5 — run /setup-matt-pocock-skills during initialization?
GUIDE_SETUP=no

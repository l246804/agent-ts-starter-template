# Pre-answered decision points for the "fullstack, split frontend/backend" profile
# (fullstack × monorepo): the workspace root hosts the Nitro server and the frontend
# lives under apps/.
#
# This file is exactly what a user would answer when running GUIDE.md attended;
# the harness exports it so the whole flow can run unattended. Names and meanings
# are the guide's answer contract (GUIDE.md, "Answers").
#
# Placeholders run.sh fills before exporting the answers:
#   __FREE_PORT__   a free port for the workspace root server (and the built server)
#   __FREE_PORT2__  a free port for the frontend app's dev server
#
# Ports are answers, not decisions: the guide has defaults for both (the root server keeps Nitro's
# 3000, the app Vite's 5173) and the harness pins them so a run cannot collide with anything else
# on the machine. Everything else below is a decision and must be answered explicitly.

# Phase 1 — shape, layout, scaffold base, package manager
GUIDE_MODE=fullstack
GUIDE_LAYOUT=monorepo
# The frontend app is the one `vp create vite:monorepo` writes (create-vite's
# vanilla-ts template); this revision does not swap it for a framework, and the
# guard refuses any other answer before writing anything.
GUIDE_FRAMEWORK=vanilla-ts
GUIDE_PM=pnpm

# Phase 2 — versions (prereleases are disclosed at this decision point)
GUIDE_VP_VERSION=1.0.0-rc.0
GUIDE_TS_VERSION=^7.0.2
GUIDE_TNB=no
GUIDE_TNB_VERSION=6.0.3-bridge.17.tsgo.7.0.2
GUIDE_NITRO_VERSION=3.0.260903-beta
GUIDE_SKILLS_VERSION=1.7.0

# Phase 3 — the layout's placeholder sub-package decision point: keep the
# scaffolded packages/utils (the home for future shared code) or delete it.
GUIDE_PLACEHOLDER=yes

# Phase 6 — the ports the smoke tests bind: the root server (which is also what the
# frontend app's DEV_PROXY points at) and the frontend dev server.
GUIDE_DEV_PORT=__FREE_PORT__
GUIDE_WEBSITE_PORT=__FREE_PORT2__

# Phase 4.5 — run /setup-matt-pocock-skills during initialization?
GUIDE_SETUP=no

# Pre-answered decision points for the "pure frontend, single repo" profile.
#
# This file is exactly what a user would answer when running GUIDE.md attended;
# the harness exports it so the whole flow can run unattended. Names and meanings
# are the guide's answer contract (GUIDE.md, "Answers").
#
# Placeholders run.sh fills before exporting the answers:
#   __STUB_PORT__  the port its deterministic proxy target listens on
#   __FREE_PORT__  a free port for the dev server
#
# Everything else is a decision and must be answered explicitly.

# Phase 1 — shape, layout, framework, package manager
GUIDE_MODE=frontend
GUIDE_LAYOUT=single
GUIDE_FRAMEWORK=react-ts
GUIDE_PM=pnpm

# Phase 2 — versions (prereleases are disclosed at this decision point)
GUIDE_VP_VERSION=1.0.0-rc.0
GUIDE_TS_VERSION=^7.0.2
GUIDE_TNB=no
GUIDE_TNB_VERSION=6.0.3-bridge.17.tsgo.7.0.2
GUIDE_SKILLS_VERSION=1.7.0

# Phase 3.5 — dev proxy: the backend address the frontend calls through /api
GUIDE_DEV_PROXY=http://127.0.0.1:__STUB_PORT__
GUIDE_PROXY_SMOKE_PATH=/hello
GUIDE_DEV_PORT=__FREE_PORT__

# Phase 4.5 — run /setup-matt-pocock-skills during initialization?
#
# This is the one profile that takes the `yes` branch, so both branches of the decision point are
# run once each (the other five profiles answer `no`). The answers below are what the user would
# give while confirming the skill's draft — and the draft is edited, which is the point:
# GUIDE_ADR_DIR is not the guide's default, so the inherited ADRs have to follow the convention the
# flow writes rather than a path hardcoded in GUIDE.md. A GitHub tracker is the one that carries a
# trap into docs/agent-notes.md, so it is the one that proves that trap is conditional on the answer.
GUIDE_SETUP=yes
GUIDE_TRACKER=github
GUIDE_DOMAIN_LAYOUT=single
GUIDE_ADR_DIR=docs/decisions

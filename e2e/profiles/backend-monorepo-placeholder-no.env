# Pre-answered decision points for the "pure backend, monorepo, no placeholder package" profile
# (backend × monorepo, GUIDE_PLACEHOLDER=no) — the backend workspace's other branch of the
# layout's placeholder decision.
#
# `backend-monorepo` keeps packages/utils (so the placeholder's own skeleton, config and build
# are asserted); this profile deletes it, which leaves the workspace with exactly one package:
# the root, which is the Nitro server. That is the arrangement's other half, and the only one
# whose TypeScript is not installed in any package of the workspace — a fact the birth
# certificate has to state rather than guess at.
#
# This file is exactly what a user would answer when running GUIDE.md attended; the harness
# exports it so the whole flow can run unattended. Names and meanings are the guide's answer
# contract (GUIDE.md, "Answers").
#
# Placeholders run.sh fills before exporting the answers:
#   __FREE_PORT__  a free port for the workspace root server (dev and built)
#
# Everything else is a decision and must be answered explicitly.

# Phase 1 — shape, layout, scaffold base, package manager
GUIDE_MODE=backend
GUIDE_LAYOUT=monorepo
# A backend project has no frontend: the guide scaffolds the monorepo template and
# deletes the app it writes, so this only picks the base that app is written from.
# vanilla-ts is the base with no framework to unpick.
GUIDE_FRAMEWORK=vanilla-ts
GUIDE_PM=pnpm

# Phase 2 — versions (prereleases are disclosed at this decision point)
GUIDE_VP_VERSION=1.0.0-rc.0
GUIDE_TS_VERSION=^7.0.2
GUIDE_TNB=no
GUIDE_TNB_VERSION=6.0.3-bridge.17.tsgo.7.0.2
GUIDE_NITRO_VERSION=3.0.260903-beta
GUIDE_SKILLS_VERSION=1.7.0

# Phase 1 — the layout's placeholder sub-package decision: this profile deletes the
# scaffolded packages/utils, so the workspace's only package is the root server.
GUIDE_PLACEHOLDER=no

# Phase 6 — the port the root server binds (dev and built)
GUIDE_DEV_PORT=__FREE_PORT__

# Phase 4.5 — run /setup-matt-pocock-skills during initialization?
GUIDE_SETUP=no
